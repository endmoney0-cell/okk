#!/bin/bash
cd "$(dirname "$0")/src"
python3 -I ../lsf.py ../$1 | grep '\.mp4' | while IFS='|' read name id date; do
  n=$(echo $name | tr -d ' '); id=$(echo $id | tr -d ' ')
  out="$2_${n%.mp4}.mp4"
  [ -s "$out" ] && continue
  curl -sSL --retry 3 -o "tmp_$out" "https://drive.usercontent.google.com/download?id=$id&export=download&confirm=t" < /dev/null
  din=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "tmp_$out" < /dev/null)
  ffmpeg -nostdin -v error -y -i "tmp_$out" -vf "scale=-2:640" -c:v libx264 -preset veryfast -crf 30 -c:a aac -ac 1 -b:a 64k "part_$out" < /dev/null && mv "part_$out" "$out"
  dout=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$out" < /dev/null)
  echo "$out in=$din out=$dout" >> ../durations.log
  rm -f "tmp_$out"
done
echo DONE $2
